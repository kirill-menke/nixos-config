{
    // "bottom" so fullscreen windows (e.g. a movie on the TV) cover the bar.
    // At "top" it draws above even fullscreen surfaces. The exclusive zone
    // still reserves space, so the bar stays visible during normal use.
    "layer": "bottom",
    "position": "top", // Waybar position (top|bottom|left|right)

    "modules-left": ["hyprland/workspaces", "tray"],
    "modules-center": ["group/hw"],
    "modules-right": ["custom/network", "bluetooth", "hyprland/language", "pulseaudio", "custom/display", "custom/weather", "clock", "custom/pomodoro", "custom/power"],

    // One box carries the pill background, so the rounded ends stay intact
    // when a member (e.g. GPU) hides itself
    "group/hw": {
        "orientation": "inherit",
        "modules": ["custom/net-speed", "memory", "cpu", "temperature", "custom/gpu"]
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true, // set false later if you go per-monitor
        "format": "{icon}",
        "format-icons": {
            "active": "◉",
            "visible": "●",
            "urgent": "●",
            "default": "○"
        },
        "on-click": "activate"
    },
    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "interval": 60,
        "tooltip": true
    },
    "clock": {
        "timezone": "Europe/Berlin",
        "format": "{:%a %d %b %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "custom/pomodoro": {
        "exec": "~/.config/waybar/scripts/pomodoro-status.sh",
        "return-type": "json",
        "interval": 1,
        "tooltip": true,
        "on-click": "pomodoro-popup",
        "cursor": true, // hand pointer; undocumented AModule option
        "on-click-right": "~/.config/waybar/scripts/pomodoro-reset.sh"
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/hypr/scripts/power-menu.sh",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        // Left click: volume + output sink card (bar-popup.py). Picking the
        // sink is worth the primary click because `play` keys its whole
        // behaviour (Atmos bitstreaming, 4K/HDR mode switch) off which sink
        // is default.
        "on-click": "bar-popup sound",
        "cursor": true,
        "on-click-right": "pavucontrol"
    },
    // Evening mode (warm tint) and monitor brightness. `nightlight daemon`
    // re-runs this through "signal" whenever the tint changes.
    "custom/display": {
        "exec": "nightlight status",
        "return-type": "json",
        "interval": 60,
        "signal": 8, // nightlight.WAYBAR_SIGNAL
        "on-click": "bar-popup display",
        "cursor": true,
        "on-click-right": "nightlight toggle"
    },
    "hyprland/language": {
        "format": "󰌌 {}",
        "format-en": "US",
        "format-de": "DE",
        "on-click": "hyprctl switchxkblayout all next"
    },
    "custom/network": {
        "exec": "~/.config/waybar/scripts/network.sh",
        "return-type": "json",
        "interval": 5,
        "tooltip": true,
        "on-click": "bar-popup network",
        "cursor": true,
        "on-click-right": "cut -d'|' -f1 /tmp/waybar-network-public-ip | wl-copy"
    },
    "bluetooth": {
        "format": "󰂯 {status}",
        "format-connected": "󰂱 {num_connections}",
        "format-disabled": "󰂲",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "bar-popup bluetooth",
        "cursor": true,
        "on-click-right": "blueman-manager"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 10,
        "show-passive-items": true
    },
    "memory": {
        "interval": 5,
        "format": "󰍛 {}%",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
    },
    "cpu": {
        "interval": 5,
        "format": "󰻠 {usage}%",
        "tooltip-format": "CPU Usage: {usage}%"
    },
    "temperature": {
        "interval": 5,
        "critical-threshold": 80,
        "format": "{temperatureC}°C",
        "tooltip-format": "CPU Temperature: {temperatureC}°C"
    },
    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "return-type": "json",
        "interval": 5,
        "tooltip": true
    },
    "custom/net-speed": {
        "exec": "~/.config/waybar/scripts/net-speed.sh",
        "return-type": "json",
        "interval": 2
    }
}
