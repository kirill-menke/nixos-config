+	// Only let clients register with redirect URIs from ALLOWED_REDIRECT_URIS
+	// (comma-separated), so an authorization code can't be sent anywhere else.
+	if allowed := os.Getenv("ALLOWED_REDIRECT_URIS"); allowed != "" {
+		allowedSet := map[string]bool{}
+		for _, u := range strings.Split(allowed, ",") {
+			if u = strings.TrimSpace(u); u != "" {
+				allowedSet[u] = true
+			}
+		}
